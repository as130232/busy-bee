# Busy Bee 環境變數清單（複製為 busy-bee-be/.env.local 使用，不含真實值）

# 執行環境：local / qa / prod
APP_ENV=local

# HTTP
HTTP_PORT=8080
# 允許的前端來源（WebSocket Origin），逗號分隔；空 = 不檢查（prod 啟動會 log config.insecure）
# prod：busy-bee-502710.web.app,busy-bee-502710.firebaseapp.com
FRONTEND_ORIGINS=

# Log：debug / info / warn / error
LOG_LEVEL=info

# PostgreSQL（對應 docker-compose.yml）
DB_URL=postgres://busybee:busybee@localhost:5432/busybee?sslmode=disable

# Firebase Auth（ID token 驗證只需 project ID）
FIREBASE_PROJECT_ID=

# 登入白名單：逗號分隔的 email 清單；留空 = fail-closed 拒絕所有人
ALLOWED_EMAILS=

# GCS 音訊儲存：bucket 名稱與簽名用 SA（本地經 impersonation 代簽，無金鑰檔）
GCS_BUCKET=
GCS_SIGNER_EMAIL=

# Groq Whisper STT（保留未接線，見 ADR-011）
GROQ_API_KEY=

# Deepgram STT（現行；會後整批辨識）。金鑰須為 Member 以上權限（即時會議要簽發短效金鑰，ADR-018）
DEEPGRAM_API_KEY=
# 未設定時預設 nova-2；DEEPGRAM_LANGUAGE 為紀錄未帶語言時的預設（zh-TW）
DEEPGRAM_MODEL=
DEEPGRAM_LANGUAGE=
# 術語加權，逗號分隔，可帶權重（如 Kubernetes:2）；nova-3 會自動去掉權重
DEEPGRAM_KEYWORDS=

# 即時會議（F-LIVE）：串流模型（預設 nova-3）與用量上限
DEEPGRAM_LIVE_MODEL=
LIVE_MONTHLY_MINUTES_LIMIT=3000
LIVE_CONTEXT_MAX_CHARS=100000
LIVE_CONTEXT_MAX_FILE_BYTES=10485760

# Gemini 文件生成（模型預設 gemini-3-flash-preview，可覆寫）
GEMINI_API_KEY=
GEMINI_MODEL=
# 主模型 404（如 Preview 下架）時自動改用；未設定時預設 gemini-3.5-flash，設成空字串則停用備援
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Web Push（VAPID）：公鑰非機密；私鑰 production 走 Secret Manager
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBSCRIBER_EMAIL=

# 內部提醒掃描端點密鑰：外部排程帶 X-Sweep-Key 呼叫 /internal/sweep-reminders 觸發提醒。空 = 端點停用。
# 2026-10-13 決定不啟用 Cloud Scheduler（省成本），提醒由 instance 內計時器在喚醒後補發（PLAN 29.11）。
REMINDER_SWEEP_SECRET=

# 背景任務（STT + 文件生成）單筆逾時，Go duration 格式
WORKER_TASK_TIMEOUT=15m
